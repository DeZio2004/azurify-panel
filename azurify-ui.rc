#!/sbin/openrc-run

command="/usr/local/azurify-ui/azurify-ui"
command_background=true
pidfile="/run/azurify-ui.pid"
description="azurify-ui Service"
procname="azurify-ui"
depend() {
    need net
}
start_pre(){
    cd /usr/local/azurify-ui
}
reload() {
  ebegin "Reloading ${RC_SVCNAME}"
  kill -USR1 $(cat $pidfile)
  eend $?
}